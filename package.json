{
	"name": "firestorm-db",
	"version": "2.0.0",
	"description": "Self hosted Firestore-like database with API endpoints based on micro bulk operations",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/esm/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./*": {
			"types": "./dist/esm/*.d.ts",
			"import": "./dist/esm/*.js",
			"require": "./dist/cjs/*.js"
		}
	},
	"scripts": {
		"prepare": "node scripts/generate-version.mjs",
		"ts:build:version": "node scripts/generate-version.mjs",
		"ts:build:esm": "pnpm ts:build:version && tsc -p tsconfig.esm.json",
		"ts:build:cjs": "pnpm ts:build:version && tsc -p tsconfig.cjs.json && node -e 'require(\"fs\").writeFileSync(\"dist/cjs/package.json\", JSON.stringify({type:\"commonjs\"}))'",
		"ts:build": "pnpm ts:build:esm && pnpm ts:build:cjs",
		"ts:tests:types": "pnpm tsx node_modules/mocha/bin/mocha.js --timeout 10000 tests/types/**/*.spec.ts",
		"ts:tests:esm": "pnpm tsx node_modules/mocha/bin/mocha.js --timeout 10000 tests/esm/**/*.spec.ts",
		"ts:tests:cjs": "pnpm tsx node_modules/mocha/bin/mocha.js --timeout 10000 tests/cjs/**/*.spec.cjs",
		"ts:tests:browser": "pnpm tsx node_modules/mocha/bin/mocha.js --timeout 10000 tests/browser/**/*.spec.ts",
		"ts:tests": "pnpm ts:build && pnpm ts:tests:types && pnpm ts:tests:esm && pnpm ts:tests:cjs && pnpm ts:tests:browser",
		"php:start": "node tests/php/php_setup.mjs",
		"php:stop": "sh tests/php/php_server_kill.sh",
		"php:lint": "phpstan analyse -c phpstan.neon --memory-limit 1G",
		"php:tests": "pnpm php:stop ; pnpm php:start && pnpm ts:tests ; e=$? ; pnpm php:stop ; exit $e",
		"docker:build": "pnpm ts:build ; bash docker/docker_image_build.bash",
		"docker:alive": "bash docker/docker_image_alive.bash",
		"docker:tests": "bash docker/docker_image_tests.bash",
		"docker:start": "bash docker/docker_image_start.bash",
		"doc:gen": "pnpm ts:build && jsdoc -r dist/esm -c jsdoc.json -R README.md -t ./node_modules/docdash -d docs && cp -r img docs/img",
		"doc:watch": "nodemon -x \"pnpm doc:gen\" --watch dist/esm --watch jsdoc.json --watch README.md",
		"lint:write": "prettier \"{,!(node_modules|dist)/**/}*.{cjs,mjs,js,ts,json,md,yml,yaml}\" --config .prettierrc --write",
		"lint:check": "prettier \"{,!(node_modules|dist)/**/}*.{cjs,mjs,js,ts,json,md,yml,yaml}\" --config .prettierrc --check",
		"coverage": "pnpm ts:build ; pnpm php:stop ; pnpm php:start && c8 pnpm tsx node_modules/mocha/bin/mocha.js tests/esm/**/*.spec.ts tests/types/**/*.spec.ts tests/cjs/**/*.spec.cjs tests/browser/**/*.spec.ts; pnpm php:stop"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TheRolfFR/firestorm-db.git"
	},
	"keywords": [
		"firebase",
		"firestore",
		"db",
		"api",
		"micro-operations",
		"bulk"
	],
	"author": "TheRolf",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/TheRolfFR/firestorm/issues"
	},
	"homepage": "https://therolffr.github.io/firestorm-db/",
	"files": [
		"dist",
		"src/server"
	],
	"engines": {
		"node": "^20.19.0 || ^22.12.0 || >=23"
	},
	"dependencies": {
		"form-data": "^4.0.6"
	},
	"devDependencies": {
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.2.0",
		"c8": "^12.0.0",
		"chai": "^6.2.2",
		"consola": "^3.4.2",
		"docdash": "^2.0.2",
		"glob": "^13.0.6",
		"jsdoc": "^4.0.5",
		"jsdoc-to-markdown": "^9.1.3",
		"mocha": "^11.8.0",
		"prettier": "^3.9.6",
		"recursive-copy": "^2.0.14",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	},
	"c8": {
		"all": false,
		"include": [
			"dist/esm/**/*.js"
		],
		"exclude": [
			"dist/esm/**/*.d.*",
			"dist/esm/types/**",
			"src/**",
			"tests/**",
			"node_modules/**"
		],
		"extension": [
			".js"
		],
		"reporter": [
			"text",
			"text-summary",
			"html"
		],
		"sourceMap": false,
		"exclude-after-remap": true,
		"check-coverage": true,
		"lines": 85,
		"statements": 85,
		"functions": 85,
		"branches": 85
	}
}
